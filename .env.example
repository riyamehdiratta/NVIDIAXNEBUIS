# Add your Nebius Token Factory key here to enable Nemotron scans.
# Never commit a real key.
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
THREADLINE_NANO_MODEL=nvidia/Nemotron-3_5-Lightning
THREADLINE_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
THREADLINE_DATA_DIR=./data
THREADLINE_IMPORT_DIR=./data/imports
THREADLINE_DEMO_MODE=0
THREADLINE_WATCH_IMPORTS=1
# Optional Google OAuth client for sending approved email through Gmail.
# Set the exact authorized redirect URI in Google Cloud Console too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
GOOGLE_FRONTEND_URL=http://localhost:5173
