{
  "$defs": {
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "string_list",
            "integer",
            "object"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "max_length": {
          "default": 500,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "description": {
          "default": "",
          "maxLength": 240,
          "title": "Description",
          "type": "string"
        },
        "taint": {
          "default": "trusted",
          "enum": [
            "trusted",
            "untrusted"
          ],
          "title": "Taint",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "WorkflowBudgets": {
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "egress_kb": {
          "default": 0,
          "maximum": 1024,
          "minimum": 0,
          "title": "Egress Kb",
          "type": "integer"
        },
        "spend": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Spend",
          "type": "number"
        }
      },
      "title": "WorkflowBudgets",
      "type": "object"
    },
    "WorkflowNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "default": "tool",
          "enum": [
            "tool",
            "map",
            "branch",
            "loop",
            "verify",
            "approval"
          ],
          "title": "Type",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "risk": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "input_taint": {
          "default": "trusted",
          "enum": [
            "trusted",
            "untrusted",
            "derived"
          ],
          "title": "Input Taint",
          "type": "string"
        },
        "over": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Over"
        },
        "do_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Do Tool"
        },
        "do_args": {
          "additionalProperties": true,
          "title": "Do Args",
          "type": "object"
        },
        "max_items": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "then_node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Then Node"
        },
        "else_node": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Else Node"
        },
        "loop_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loop Until"
        },
        "max_iterations": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "loop_body": {
          "items": {
            "type": "string"
          },
          "title": "Loop Body",
          "type": "array"
        },
        "verify_against": {
          "items": {
            "type": "string"
          },
          "title": "Verify Against",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "WorkflowNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "default": "Untitled workflow",
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 500,
      "title": "Description",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "origin": {
      "default": "user_request",
      "enum": [
        "user_request",
        "skill",
        "schedule",
        "event",
        "repair"
      ],
      "title": "Origin",
      "type": "string"
    },
    "trigger": {
      "default": "on_demand",
      "enum": [
        "on_demand",
        "schedule",
        "event"
      ],
      "title": "Trigger",
      "type": "string"
    },
    "schedule_cron": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schedule Cron"
    },
    "event_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Type"
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/InputSpec"
      },
      "title": "Inputs",
      "type": "object"
    },
    "budgets": {
      "$ref": "#/$defs/WorkflowBudgets"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/WorkflowNode"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "nodes"
  ],
  "title": "WorkflowSpec",
  "type": "object"
}
